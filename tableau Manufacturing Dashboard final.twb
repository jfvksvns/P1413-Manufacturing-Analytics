      <aliases enabled='yes' />
      <column datatype='integer' name='[Buyer Founded Year]' role='measure' type='quantitative' />
      <column caption='Buyer ID' datatype='string' name='[Buyer_ID]' role='dimension' type='nominal' />
      <column caption='Utilization%' datatype='real' default-format='p0.00%' name='[Calculation_0031389242839040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Processed_Qty]) / SUM([WO_Qty])' />
      </column>
      <column caption='Efficiency%' datatype='real' default-format='p0.00%' name='[Calculation_0031389248483329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Produced_Qty]) / SUM([Processed_Qty])' />
      </column>
      <column caption='Cost Per Unit ' datatype='real' name='[Calculation_0031389248692226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Value]) / SUM([Produced_Qty])' />
      </column>
      <column caption='Rejection%' datatype='real' default-format='p0.00%' name='[Calculation_0031389249048579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Rejected_Qty]) / SUM([Produced_Qty])' />
      </column>
      <column caption='Good Quantity' datatype='integer' name='[Calculation_0432163003875328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Produced_Qty]) - SUM([Rejected_Qty])' />
      </column>
      <column caption='Orders with zero Rejections' datatype='integer' name='[Calculation_0432163004096513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Rejected_Qty] = 0 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Wastage%' datatype='real' default-format='p0.00%' name='[Calculation_0432163111104514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Produced_Qty]) = 0 THEN NULL&#13;&#10;ELSE SUM([Rejected_Qty]) / SUM([Produced_Qty])&#13;&#10;END' />
      </column>
      <column caption='Total Wastage %' datatype='real' default-format='p0.00%' name='[Calculation_0432163112042499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([Rejected_Qty]) } / { FIXED : SUM([Produced_Qty]) }' />
      </column>
      <column caption='Total Wastage' datatype='integer' default-format='p0.00%' name='[Calculation_0432163112374276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Rejected_Qty])' />
      </column>
      <column caption='On-Time%' datatype='real' default-format='p0.00%' name='[Calculation_1513257121828864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Delivery_Status] = &quot;On Time&quot; THEN 1 ELSE 0 END) / COUNT([Doc_Num])' />
      </column>
      <column caption='Late%' datatype='real' default-format='p0.00%' name='[Calculation_1513257122021377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Delivery_Status] = &quot;Late&quot; THEN 1 ELSE 0 END) / COUNT([Doc_Num])' />
      </column>
      <column caption='Repeat%' datatype='real' default-format='p0.00%' name='[Calculation_1513257122217986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Is_Repeat_Order] = &quot;Yes&quot; THEN 1 ELSE 0 END) / COUNT([Doc_Num])' />
      </column>
      <column caption='Cost per Unit' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Cost_per_Unit]' role='measure' type='quantitative' />
      <column caption='Customer Code' datatype='string' name='[Customer_Code]' role='dimension' type='nominal' />
      <column caption='Delivery Status' datatype='string' name='[Delivery_Status]' role='dimension' type='nominal' />
      <column caption='Dept ID' datatype='string' name='[Dept_ID]' role='dimension' type='nominal' />
      <column caption='Doc Num' datatype='string' name='[Doc_Num]' role='dimension' type='nominal' />
      <column caption='Efficiency Rate Pct' datatype='real' name='[Efficiency_Rate_Pct]' role='measure' type='quantitative' />
      <column caption='Is Repeat Order' datatype='string' name='[Is_Repeat_Order]' role='dimension' type='nominal' />
      <column caption='Item Code' datatype='string' name='[Item_Code]' role='dimension' type='nominal' />
